<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 控制台日志 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 日志1：聊天交互 -->
    <appender name="LLM_CHAT_FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/llm-chat.log</file>
        <append>false</append>
        <encoder><pattern>%msg%n</pattern></encoder>
    </appender>

    <!-- 日志2：上下文压缩 -->
    <appender name="LLM_SUMMARY_FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/llm-summary.log</file>
        <append>false</append>
        <encoder><pattern>%msg%n</pattern></encoder>
    </appender>

    <!-- 日志3：用户画像抽取 -->
    <appender name="LLM_PROFILE_FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/llm-profile.log</file>
        <append>false</append>
        <encoder><pattern>%msg%n</pattern></encoder>
    </appender>

    <!-- 根日志 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="LLM_CHAT" level="INFO" additivity="false">
        <appender-ref ref="LLM_CHAT_FILE"/>
    </logger>

    <logger name="LLM_SUMMARY" level="INFO" additivity="false">
        <appender-ref ref="LLM_SUMMARY_FILE"/>
    </logger>

    <logger name="LLM_PROFILE" level="INFO" additivity="false">
        <appender-ref ref="LLM_PROFILE_FILE"/>
    </logger>
</configuration>
